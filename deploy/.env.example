LODESTAR_VERSION=dev
LODESTAR_HTTP_PORT=8080
LODESTAR_PUBLIC_URL=http://localhost:8080
# Сгенерировать: openssl rand -base64 32
LODESTAR_SECRET_KEY=
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=lodestar
MINIO_ROOT_PASSWORD=change-me-too
# Тестовый вуз demo, только для показа: docker compose --profile demo
DEMO_IDP_ISSUER=http://localhost:8090
DEMO_IDP_CLIENT_SECRET=
# Режим тестировщика: make tester. Для входа с телефона замените localhost на IP компьютера
# LODESTAR_S3_PUBLIC_ENDPOINT=http://localhost:9000
# Навигатор через Ollama на этом компьютере: ollama pull qwen2.5:7b && ollama pull bge-m3
# LODESTAR_LLM_URL=http://host.docker.internal:11434/v1
# LODESTAR_LLM_MODEL=qwen2.5:7b
# LODESTAR_EMBED_URL=http://host.docker.internal:11434/v1
# LODESTAR_EMBED_MODEL=bge-m3
