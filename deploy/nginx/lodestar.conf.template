map $http_upgrade $lodestar_connection {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name __NAMES__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name __DOMAIN__;
    ssl_certificate __CERTS__/fullchain.pem;
    ssl_certificate_key __CERTS__/privkey.pem;

    client_max_body_size 200m;

    location / {
        proxy_pass http://__SERVER__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $lodestar_connection;
        proxy_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name s3.__DOMAIN__;
    ssl_certificate __CERTS__/fullchain.pem;
    ssl_certificate_key __CERTS__/privkey.pem;

    client_max_body_size 0;

    location / {
        proxy_pass http://__S3__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering off;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name mail.__DOMAIN__;
    ssl_certificate __CERTS__/fullchain.pem;
    ssl_certificate_key __CERTS__/privkey.pem;

    auth_basic "Lodestar mail";
    auth_basic_user_file __HTPASSWD__;

    location / {
        proxy_pass http://__MAIL__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $lodestar_connection;
    }
}
